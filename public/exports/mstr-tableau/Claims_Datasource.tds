  </column>
  <column caption="Count (Region)" datatype="real" name="[Count (Region)]" role="measure" type="quantitative">
    <calculation class="tableau" formula="COUNTD([Region])"/>
  </column>
  <column caption="Litigation Claims" datatype="real" name="[Litigation Claims]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM(IF ([Litigation] = &quot;Yes&quot;) THEN 1 ELSE 0 END)"/>
  </column>
  <column caption="Litigation Rate" datatype="real" name="[Litigation Rate]" role="measure" type="quantitative">
    <calculation class="tableau" formula="IIF(COUNT([Claim ID]) = 0, NULL, SUM(IF ([Litigation] = &quot;Yes&quot;) THEN 1 ELSE 0 END) / COUNT([Claim ID]))"/>
  </column>
  <column caption="Recovery Amount USD" datatype="real" name="[Recovery Amount USD]" role="measure" type="quantitative"/>
