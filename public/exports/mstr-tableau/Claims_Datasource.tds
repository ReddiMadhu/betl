  </column>
  <column caption="Count (Claim ID)" datatype="real" name="[Count (Claim ID)]" role="measure" type="quantitative">
    <calculation class="tableau" formula="COUNT([Claim ID])"/>
  </column>
  <column caption="Recovery" datatype="real" name="[Recovery]" role="measure" type="quantitative">
    <calculation class="tableau" formula="ZN(SUM([Recovery Amount USD]))"/>
  </column>
  <column caption="Claim Resolution Time Days" datatype="real" name="[Claim Resolution Time Days]" role="measure" type="quantitative"/>
  <column caption="Avg (Fraud Score)" datatype="real" name="[Avg (Fraud Score)]" role="measure" type="quantitative">
    <calculation class="tableau" formula="AVG([Fraud Score])"/>
  </column>
  <column caption="Total Incurred" datatype="real" name="[Total Incurred]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM([Total Incurred USD])"/>
  </column>
  <column caption="Net Losses" datatype="real" name="[Net Losses]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM(([Paid Amount USD] + [Reserve Amount USD]) - [Recovery Amount USD])"/>
  </column>
  <column caption="Sum (Salvage)" datatype="real" name="[Sum (Salvage)]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM(ZN([Salvage]))"/>
  </column>
  <column caption="Total_Claims" datatype="real" name="[Total_Claims]" role="measure" type="quantitative">
    <calculation class="tableau" formula="COUNT([Claim ID])"/>
  </column>
  <column caption="Paid Amount USD" datatype="real" name="[Paid Amount USD]" role="measure" type="quantitative"/>
  <column caption="Top State Loss" datatype="real" name="[Top State Loss]" role="measure" type="quantitative">
    <calculation class="tableau" formula="MAX([Total Incurred USD])"/>
  </column>
  <column caption="Litigation Incurred Loss" datatype="real" name="[Litigation Incurred Loss]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM(IF ([Litigation] = &quot;Yes&quot;) THEN [Total Incurred USD] ELSE 0 END)"/>
  </column>
  <column caption="High Fraud Rate" datatype="real" name="[High Fraud Rate]" role="measure" type="quantitative">
    <calculation class="tableau" formula="IIF(COUNT([Claim ID]) = 0, NULL, SUM(IF ([Fraud Score] &gt;= 70) THEN 1 ELSE 0 END) / COUNT([Claim ID]))"/>
  </column>
  <column caption="Count (Adjuster Name)" datatype="real" name="[Count (Adjuster Name)]" role="measure" type="quantitative">
