  </column>
  <column caption="Total Incurred USD" datatype="real" name="[Total Incurred USD]" role="measure" type="quantitative"/>
  <column caption="Paid Amount" datatype="real" name="[Paid Amount]" role="measure" type="quantitative">
    <calculation class="tableau" formula="ZN(SUM([Paid Amount USD]))"/>
  </column>
  <column caption="Subrogation" datatype="real" name="[Subrogation]" role="measure" type="quantitative"/>
  <column caption="State Loss Rank" datatype="real" name="[State Loss Rank]" role="measure" type="quantitative">
    <calculation class="tableau" formula="Rank(MAX([Total Incurred USD]))"/>
  </column>
  <column caption="Row Count - MSTR_PC_Claims_Sample_Data_500K_With_Resolution_Time.xlsx" datatype="real" name="[Row Count - MSTR_PC_Claims_Sample_Data_500K_With_Resolution_Time.xlsx]" role="measure" type="quantitative"/>
