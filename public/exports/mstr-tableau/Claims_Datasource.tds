  <column caption="High Fraud Claims" datatype="real" name="[High Fraud Claims]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM(IF ([Fraud Score] &gt;= 70) THEN 1 ELSE 0 END)"/>
  </column>
  <column caption="Sum (Subrogation)" datatype="real" name="[Sum (Subrogation)]" role="measure" type="quantitative">
    <calculation class="tableau" formula="ZN(SUM([Subrogation]))"/>
  </column>
  <column caption="Reserve" datatype="real" name="[Reserve]" role="measure" type="quantitative">
    <calculation class="tableau" formula="ZN(SUM([Reserve Amount USD]))"/>
