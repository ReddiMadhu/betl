# ─── Azure Storage Connection ───
# These values auto-fill the ingestion modal when present.
# Remove or leave blank to enter values manually in the UI.

VITE_AZURE_STORAGE_ACCOUNT=sympbistorage
VITE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=sympbistorage;AccountKey=xxxxx;EndpointSuffix=core.windows.net
VITE_AZURE_STORAGE_CONTAINER=bi-etl-assets
